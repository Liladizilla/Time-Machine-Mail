{
  "name": "time-machine-mail",
  "version": "0.1.2",
  "private": true,
  "description": "A chronological email workspace for messages anchored to chosen dates.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test",
    "desktop:dev": "concurrently -k -s first \"npm:dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --publish never --linux AppImage deb",
    "desktop:dist:win": "npm run build && npm run desktop:prepare && electron-builder --publish never --win nsis",
    "desktop:dist:mac": "npm run build && npm run desktop:prepare && electron-builder --publish never --mac dmg",
    "desktop:prepare": "npm install --omit=dev --no-audit --no-fund --prefix .next/standalone && node -e \"const p=require('path').resolve('.next/standalone'); const fs=require('fs'); if(!fs.existsSync(require('path').join(p,'server.js'))) throw Error('Next standalone server.js is missing'); if(!fs.existsSync(require('path').join(p,'node_modules/next/package.json'))) throw Error('Next runtime package is missing from standalone node_modules'); require.resolve('next', { paths: [p] }); console.log('Verified standalone Next.js runtime:', require.resolve('next', { paths: [p] }));\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^1.59.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.0",
    "typescript": "^7.0.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "dev.timemachinemail.desktop",
    "productName": "Time Machine Mail",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "151440626+Liladizilla@users.noreply.github.com"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.png",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "author": {
    "name": "Charis_Chara",
    "email": "151440626+Liladizilla@users.noreply.github.com"
  }
}
